* text=auto eol=lf

# Скрипты исполняются в CI на Linux/macOS — переводы строк только LF,
# иначе bash падает с "bad interpreter: /usr/bin/env: ^M".
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.swift     text eol=lf
*.plist     text eol=lf
*.json      text eol=lf
*.md        text eol=lf

# Windows-скрипты остаются в CRLF.
*.ps1       text eol=crlf

# Бинарные файлы
*.png       binary
*.ipa       binary
*.sqlite    binary
